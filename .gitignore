evaluation_and_analysis/HF_TOKEN.txt

# All subfolders (and their contents) under these directories, but not the
# placeholder .txt files that live directly inside them
eval_generated_pred/*/
finetune_data/*/
finetuned_models/*/
models/*/

# Every preprocessed pretraining set (PMI, ROUGE, SBERT, ... - current and future
# ones alike), together with the arrow cache files their preprocessing writes
PREPROCESSED_DATASETS/*/
PREPROCESSED_DATASETS/*.arrow
cache/

finetune_data/*.tar

# Everything the LLM-as-a-judge scripts write into the result folders: the
# per-comparison result JSONs, their aggregate .log files, the per-dataset
# summary logs, and the .partial.jsonl resume files. Covers step 5 (vs. the
# reference summaries), step 6 (Prometheus vs. the source documents), step 7
# (paid API vs. the source documents) and any later step that keeps the same
# "<dataset>_<checkpoint>_llm_judge_..._stepN.<ext>" naming.
#
# Anchored on "__step<digit>" rather than just "llm_judge" on purpose: the
# versioned folders (wikihow_llm_judge_vs_source_docs--v1/ and friends) also
# carry "llm_judge" in their names, and the .log files inside them are meant to
# stay tracked -- see the rules below.
evaluation_and_analysis/*_result_files/*llm_judge*__step[0-9]*

# Belt and braces: resume files are pure scratch wherever they land.
*.partial.jsonl

# Per-comparison result JSONs inside the versioned step 6 judge-vs-source-docs
# folders (the .log files there stay tracked)
evaluation_and_analysis/wikihow_result_files/wikihow_llm_judge_vs_source_docs--v1/**/*.json
evaluation_and_analysis/xsum_result_files/xsum_llm_judge_vs_source_docs--v1/**/*.json
evaluation_and_analysis/cnn_result_files/cnn_llm_judge_vs_source_docs--v1/**/*.json

__pycache__/

.idea/copilot.data.migration.agent.xml
.idea/copilot.data.migration.ask2agent.xml
.idea/copilot.data.migration.edit.xml
.idea/copilot.data.migration.ask.xml
